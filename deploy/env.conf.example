# ============================================================
# AgentChat-v2 部署配置模板
#
# 用法：复制为 deploy/env.conf 后按实际环境修改。
#   Linux : cp env.conf.example env.conf && chmod 600 env.conf
#   Windows: Copy-Item env.conf.example env.conf
#
# env.conf 含密钥，不要提交到代码库。
# 格式：KEY=VALUE，一行一个；# 开头为注释；值里含空格请用双引号包起来。
# Linux 脚本与 Windows 脚本读的是同一份 env.conf。
# ============================================================

# ---------- 路径 ----------
# 应用根目录（可绝对路径，也可相对脚本所在目录的上一级）
APP_HOME=..
# jar 路径：绝对路径，或相对 APP_HOME 的路径
JAR=target/agentchat-v2-2.1.0.jar
# java 可执行文件（PATH 里没有时写绝对路径，如 /usr/local/jdk17/bin/java）
JAVA_BIN=java
# JVM 参数
# 建议加 -DLOG_PATH=/opt/agentchat-v2/logs/app，把应用文件日志（/api/logs 数据源）
# 固定到 APP_HOME 下；不加则落到 java.io.tmpdir，重启后可能丢失。
# file.encoding/sun.jnu.encoding 必须为 UTF-8：Milvus 的 BM25 中文检索依赖 JVM 默认字符集，
# JDK 17 在中文 Windows 上默认 GBK，会导致 Milvus 报 "string data must be utf8 format"。
JAVA_OPTS="-Xms512m -Xmx2g -XX:+UseG1GC -Dfile.encoding=UTF-8 -Dsun.jnu.encoding=UTF-8 -Duser.timezone=Asia/Shanghai -DLOG_PATH=./logs/app"
# 日志目录与控制台日志文件（相对 APP_HOME）
LOG_DIR=logs
CONSOLE_LOG=console.log
# PID 文件（相对 APP_HOME）
PID_FILE=run/agentchat.pid

# ---------- 应用 ----------
SERVER_PORT=8092
SPRING_PROFILES=prod
# 启动等待：最多等多少秒健康检查通过
START_TIMEOUT=120
# 停止等待：SIGTERM 后最多等多少秒再强杀
STOP_TIMEOUT=30

# ---------- 模型（内网网关）----------
# 注意：内网网关若是明文 http://，必须使用 AgentScope 2.0.4+（本项目已升到 2.0.5），
#       否则 JDK 会在明文上尝试 h2c upgrade，网关丢请求体导致 400。
# 下面这行是占位示例（10.0.0.10:8000 只是随手写的地址，8000 是 vLLM 的默认端口），
# 部署时必须换成你们真实的网关地址；端口以网关实际监听为准。
AI_BASE_URL=http://10.0.0.10:8000/v1
AI_API_KEY=sk-please-change-me
AI_CHAT_MODEL=deepseek-v4-pro

# 可选：深度思考模型（mode=deep），不配则回落到主模型
# AI_REASONER_BASE_URL=
# AI_REASONER_API_KEY=
# AI_REASONER_MODEL=deepseek-reasoner

# 可选：备用模型（主模型故障降级），不配 chat-model 则不启用
# AI_FALLBACK_BASE_URL=
# AI_FALLBACK_API_KEY=
# AI_FALLBACK_MODEL=

# 可选：Embedding（知识库语义检索）。不配 base-url/model 则只做全文检索（BM25）
#   api-key 允许留空：留空时不会发送 Authorization 头，适用于内网无鉴权的本地模型
#   base-url 填 OpenAI 兼容根路径，带 /v1、不带尾斜杠（代码会拼 /embeddings）
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_MAX_TOKENS=512

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- Nacos ----------
# 内网没有 Nacos 时请设为 false，否则启动日志会反复重试
NACOS_ENABLED=false
# NACOS_SERVER=127.0.0.1:8848
# NACOS_NAMESPACE=public

# ---------- 其他 ----------
# 管理接口令牌；留空则仅允许本机访问管理接口
# ADMIN_TOKEN=
# 上传目录
# UPLOAD_DIR=./uploads
# RAG 总开关；知识库检索依赖 Milvus 3.0（默认 http://127.0.0.1:19530），
# Milvus 不可用时应用仍可启动，只是检索降级（health.milvus=down）
# RAG_ENABLED=true
# MILVUS_URI=http://127.0.0.1:19530
# MILVUS_COLLECTION_VERSION=v1
